<!-- MODEL DETAIL -->
<div class="page-header">
    <a href="index.php?p=models" class="back-btn">← Modelos</a>
    <div class="flex items-center gap-1 mb-1">
        <span class="badge badge-{{model_type_raw}}">{{model_emoji}} {{model_type}}</span>
        <span class="word-count-badge">{{model_words}} palabras</span>
    </div>
    <h1 class="page-title">{{model_title}}</h1>
</div>

<div class="prompt-box">
    <strong>📝 Consigna:</strong><br>
    {{model_prompt}}
</div>

<div class="section-title">📄 Modelo completo</div>
<div class="content-box">{{model_content}}</div>

<div class="section-title mt-2">🔗 Useful Language</div>
<div class="card mb-2">
    <div class="card-body">
        {{#useful_lang}}
        <div class="ul-section">
            <div class="ul-category">{{category}}</div>
            <ul class="ul-list">
                {{#expressions}}
                <li class="ul-item"><span>{{text}}</span></li>
                {{/expressions}}
            </ul>
        </div>
        {{/useful_lang}}
    </div>
</div>

{{#has_sessions}}
<div class="section-title mt-2">📊 Historial</div>
{{#sessions}}
<div class="session-card">
    <div class="session-card-header">
        <div class="session-card-title">Día {{day_number}}</div>
        <div class="session-card-date">{{date_formatted}}</div>
    </div>
    <div class="session-card-stats">
        <div class="session-stat">
            <div class="session-stat-value">{{copy_formatted}}</div>
            <div class="session-stat-label">Copia</div>
        </div>
        <div class="session-stat">
            <div class="session-stat-value">{{draft_formatted}}</div>
            <div class="session-stat-label">Borrador</div>
        </div>
        <div class="session-stat">
            <div class="session-stat-value">{{errors}}</div>
            <div class="session-stat-label">Errores</div>
        </div>
        <div class="session-stat">
            <div class="session-stat-value">{{feeling}}/10</div>
            <div class="session-stat-label">Sensación</div>
        </div>
    </div>
</div>
{{/sessions}}
{{/has_sessions}}

<div class="mt-2 mb-2">
    <a href="index.php?p=session&model_id={{model_id}}&day={{next_day}}" class="btn btn-primary btn-block">
        ✍️ Iniciar sesión
    </a>
</div>
